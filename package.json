{
  "name": "manimvs",
  "displayName": "manimvs",
  "description": "Helping to make manimgl easier to use",
  "version": "0.0.2",
  "publisher": "lolloz98",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "manimvs.onCursorCheckpointPaste",
        "title": "ManimGl: On Cursor CheckpointPaste"
      },
      {
        "command": "manimvs.selectTerminal",
        "title": "ManimGl: Select Terminal"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lolloz98/manimvs.git"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.5.1",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.10.0",
    "typescript": "^5.6.3"
  }
}
